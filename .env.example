# Clé API Anthropic (Claude). Ne jamais commiter la vraie valeur.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle utilisé pour la génération des agents.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Base de données locale (SQLite via Prisma).
# En production, remplacer par une URL Postgres, ex:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"
